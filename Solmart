      outlet.innerHTML = `
        <div class="section-head">
          <h1 class="section-title">${escapeHTML(t('favorites'))} (${formatNum(items.length)})</h1>
          ${items.length ? `<button type="button" class="btn btn-primary btn-sm" id="add-all-wish-btn">${icon('cart', 16)} <span>${escapeHTML(t('addAllToCart'))}</span></button>` : ''}
        </div>
        ${items.length ? `
          <div class="product-grid">${items.map((p) => renderProductCard(p)).join('')}</div>
        ` : `
          <div class="card-box" style="text-align:center;padding:48px 20px;">
            <p style="color:var(--muted);margin-block-end:16px;">${escapeHTML(t('emptyWishlist'))}</p>
            <a href="#/catalog" class="btn btn-primary">${escapeHTML(t('startShopping'))}</a>
          </div>
        `}
      `;
      document.getElementById('add-all-wish-btn')?.addEventListener('click', () => {
        items.forEach((p) => addToCart(p.id, 1));
      });
    }

    let compareHighlightDiffs = false;

    function renderComparePage(outlet) {
      const s = Store.state;
      const items = s.compare.map((id) => s.products.find((p) => p.id === id)).filter(Boolean);
      const rows = [
        { label: t('priceRange'), vals: items.map((p) => formatPrice(p.price)) },
        { label: t('brand'), vals: items.map((p) => p.brand) },
        { label: t('reviews'), vals: items.map((p) => `★ ${formatNum(p.rating)} (${formatNum(p.reviewCount)})`) },
        { label: t('shipping'), vals: items.map((p) => p.deliveryDays === 1 ? t('deliveryTomorrow') : t('deliveryDays', { n: formatNum(p.deliveryDays) })) },
        { label: t('discount'), vals: items.map((p) => `−${formatNum(p.discount)}%`) }
      ].filter((r) => {
        if (!compareHighlightDiffs || items.length < 2) return true;
        return new Set(r.vals).size > 1;
      });

      outlet.innerHTML = `
        <div class="section-head">
          <h1 class="section-title">${escapeHTML(t('compare'))} (${formatNum(items.length)}/4)</h1>
          ${items.length ? `
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <label style="display:inline-flex;align-items:center;gap:6px;font-size:var(--fs-12);font-weight:600;cursor:pointer;">
                <input type="checkbox" id="diff-only-cb" ${compareHighlightDiffs ? 'checked' : ''} />
                <span>${escapeHTML(t('highlightDiffs'))}</span>
              </label>
              <button type="button" class="btn btn-secondary btn-sm" id="clear-compare-btn">${escapeHTML(t('clear'))}</button>
            </div>
          ` : ''}
        </div>
        ${items.length === 0 ? `
          <div class="card-box" style="text-align:center;padding:48px 20px;">
            <p style="color:var(--muted);margin-block-end:16px;">${escapeHTML(t('emptyCompare'))}</p>
            <a href="#/catalog" class="btn btn-primary">${escapeHTML(t('startShopping'))}</a>
          </div>
        ` : `
          <div class="card-box table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>${escapeHTML(t('specifications'))}</th>
                  ${items.map((p) => `
                    <th style="min-width:190px;vertical-align:top;">
                      <div style="display:flex;justify-content:space-between;align-items:start;margin-block-end:8px;">
                        <img src="${p.images[0]}" alt="" style="width:72px;height:72px;border-radius:10px;object-fit:cover;" />
                        <button type="button" class="icon-btn remove-comp-item" data-id="${p.id}" style="width:28px;height:28px;" aria-label="${escapeHTML(t('clear'))}">${icon('x', 15)}</button>
                      </div>
                      <a href="#/product/${p.id}" style="color:var(--text);font-size:var(--fs-14);font-weight:700;display:block;margin-block-end:8px;">${escapeHTML(trObj(p.title))}</a>
                      <button type="button" class="btn btn-primary btn-sm" data-action="add-to-cart" data-id="${p.id}">${escapeHTML(t('addToCart'))}</button>
                    </th>
                  `).join('')}
                </tr>
              </thead>
              <tbody>
                ${rows.map((r) => `
                  <tr>
                    <th>${escapeHTML(r.label)}</th>
                    ${r.vals.map((v) => `<td><bdi>${escapeHTML(v)}</bdi></td>`).join('')}
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `}
      `;

      document.getElementById('diff-only-cb')?.addEventListener('change', (e) => {
        compareHighlightDiffs = e.target.checked;
        renderComparePage(outlet);
      });
      document.getElementById('clear-compare-btn')?.addEventListener('click', () => {
        Store.set({ compare: [] });
        renderComparePage(outlet);
      });
      outlet.querySelectorAll('.remove-comp-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          Store.set({ compare: Store.state.compare.filter((x) => x !== id) });
          renderComparePage(outlet);
        });
      });
    }

