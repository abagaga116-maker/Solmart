    function renderCatalogPage(outlet, queryParams) {
      const s = Store.state;
      const lang = s.lang;

      // Derive filter state cleanly from URL parameters so filters never "stick" unexpectedly
      const filterState = {
        category: queryParams.get('category') || '',
        q: queryParams.get('q') || '',
        minPrice: Number(queryParams.get('min')) || 0,
        maxPrice: Number(queryParams.get('max')) || 1500,
        brands: queryParams.get('brands') ? queryParams.get('brands').split(',').filter(Boolean) : [],
        minRating: Number(queryParams.get('rating')) || 0,
        discountOnly: queryParams.get('discount') === 'true',
        inStockOnly: queryParams.get('stock') === 'true',
        fastDelivery: queryParams.get('fast') === 'true',
        sort: queryParams.get('sort') || 'popular',
        viewMode: s.catalogView || 'grid'
      };

      const syncUrlAndRerender = () => {
        const p = new URLSearchParams();
        if (filterState.category) p.set('category', filterState.category);
        if (filterState.q) p.set('q', filterState.q);
        if (filterState.minPrice > 0) p.set('min', String(filterState.minPrice));
        if (filterState.maxPrice < 1500) p.set('max', String(filterState.maxPrice));
        if (filterState.brands.length) p.set('brands', filterState.brands.join(','));
        if (filterState.minRating > 0) p.set('rating', String(filterState.minRating));
        if (filterState.discountOnly) p.set('discount', 'true');
        if (filterState.inStockOnly) p.set('stock', 'true');
        if (filterState.fastDelivery) p.set('fast', 'true');
        if (filterState.sort && filterState.sort !== 'popular') p.set('sort', filterState.sort);
        const nextHash = `#/catalog${p.toString() ? '?' + p.toString() : ''}`;
        history.replaceState(null, '', nextHash);
        renderCatalogPage(outlet, p);
      };

      const allBrands = [...new Set(s.products.map((p) => p.brand))].sort();
      const normQ = normalizeArabic(filterState.q);

      const filtered = s.products.filter((p) => {
        if (p.status === 'draft') return false;
        if (filterState.category && p.category !== filterState.category) return false;
        if (normQ) {
          const match =
            normalizeArabic(p.title.en).includes(normQ) ||
            normalizeArabic(p.title.ar).includes(normQ) ||
            normalizeArabic(p.title.ru).includes(normQ) ||
            normalizeArabic(p.brand).includes(normQ) ||
            normalizeArabic(p.seller).includes(normQ);
          if (!match) return false;
        }
        if (p.price < filterState.minPrice || p.price > filterState.maxPrice) return false;
        if (filterState.brands.length && !filterState.brands.includes(p.brand)) return false;
        if (p.rating < filterState.minRating) return false;
        if (filterState.discountOnly && p.discount <= 0) return false;
        if (filterState.inStockOnly && p.stock <= 0) return false;
        if (filterState.fastDelivery && p.deliveryDays > 1) return false;
        return true;
