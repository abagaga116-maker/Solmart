    /* ==========================================================================
       MODULE 11: SHOPPING CART & SAVE FOR LATER
       ========================================================================== */
    function addToCart(productId, delta = 1, sourceEl = null) {
      const s = Store.state;
      const prod = s.products.find((p) => p.id === productId);
      if (!prod) return;
      triggerHaptic(15);
      const existing = s.cart.find((c) => c.productId === productId);
      let nextCart;
      if (existing) {
        nextCart = s.cart.map((c) => c.productId === productId ? { ...c, qty: Math.max(1, c.qty + delta) } : c);
      } else {
        nextCart = [...s.cart, { productId, qty: Math.max(1, delta), selected: true, color: prod.colors?.[0] || '#FF6A2E', size: prod.sizes?.[0] || 'Standard' }];
      }
      Store.set({ cart: nextCart });
      if (sourceEl) Motion.flyToCart(sourceEl);
      showToast(`${trObj(prod.title)} — ${t('inCart')}`, 'success');
    }

    function calculateCartTotals() {
      const s = Store.state;
      let subtotalCents = 0;
      let oldSubtotalCents = 0;
      s.cart.forEach((item) => {
        if (!item.selected) return;
        const p = s.products.find((x) => x.id === item.productId);
        if (p) {
          subtotalCents += Math.round(p.price * 100) * item.qty;
          oldSubtotalCents += Math.round((p.oldPrice || p.price) * 100) * item.qty;
        }
      });
      const subtotal = subtotalCents / 100;
      const oldSubtotal = oldSubtotalCents / 100;
      let promoDiscount = 0;
      if (s.promoCode === 'SOL10') promoDiscount = Math.round(subtotal * 10) / 100;
      if (s.promoCode === 'BRIGHT20' && subtotal >= 200) promoDiscount = Math.round(subtotal * 20) / 100;
      const shipping = subtotal >= 100 || subtotal === 0 || s.promoCode === 'FREESHIP' ? 0 : 12;
      const total = Math.max(0, subtotal - promoDiscount + shipping);
      return { subtotal, oldSubtotal, promoDiscount, shipping, total };
    }

