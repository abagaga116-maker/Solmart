              <div style="display:flex;justify-content:space-between;align-items:center;margin-block-end:8px;">
                <span style="font-size:var(--fs-12);font-weight:700;color:var(--muted);">${escapeHTML(t('recentSearches'))}</span>
                <button type="button" id="clear-search-hist" style="font-size:var(--fs-12);color:var(--primary-strong);font-weight:700;">${escapeHTML(t('clear'))}</button>
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                ${s.searchHistory.map((item) => `
                  <span class="badge badge-muted" style="padding:5px 10px;display:inline-flex;align-items:center;gap:6px;">
                    <a href="#/catalog?q=${encodeURIComponent(item)}">${escapeHTML(item)}</a>
                    <button type="button" data-del-hist="${escapeHTML(item)}" aria-label="${escapeHTML(t('clear'))}" style="font-weight:800;">×</button>
                  </span>
                `).join('') || `<span style="font-size:var(--fs-12);color:var(--muted);">—</span>`}
              </div>
            </div>
            <div>
              <span style="font-size:var(--fs-12);font-weight:700;color:var(--muted);display:block;margin-block-end:8px;">${escapeHTML(t('popularSearches'))}</span>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                ${['SolPods', 'Espresso', 'AMOLED', 'Matcha', 'Sneakers', 'VR'].map((p) => `<a href="#/catalog?q=${encodeURIComponent(p)}" class="badge badge-primary" style="padding:5px 10px;">${escapeHTML(p)}</a>`).join('')}
              </div>
            </div>
          `;
          dropdown.querySelector('#clear-search-hist')?.addEventListener('click', (ev) => {
            ev.stopPropagation();
            Store.set({ searchHistory: [] });
            renderSuggestions('');
          });
          dropdown.querySelectorAll('[data-del-hist]').forEach((btn) => {
            btn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              const target = btn.getAttribute('data-del-hist');
              Store.set({ searchHistory: Store.state.searchHistory.filter((x) => x !== target) });
              renderSuggestions('');
            });
          });
          return;
        }

        const normQ = normalizeArabic(clean);
        const matches = s.products.filter((p) => {
          return (
            normalizeArabic(p.title.en).includes(normQ) ||
            normalizeArabic(p.title.ar).includes(normQ) ||
            normalizeArabic(p.title.ru).includes(normQ) ||
            normalizeArabic(p.brand).includes(normQ)
          );
        }).slice(0, 6);

        const safeHighlight = (rawText) => {
          const escaped = escapeHTML(rawText);
          const escapedQ = escapeHTML(clean);
          const idx = escaped.toLowerCase().indexOf(escapedQ.toLowerCase());
          if (idx === -1 || !escapedQ) return escaped;
          return (
            escaped.slice(0, idx) +
            `<span class="search-highlight">${escaped.slice(idx, idx + escapedQ.length)}</span>` +
            escaped.slice(idx + escapedQ.length)
          );
        };

        dropdown.innerHTML = matches.length ? `
          <div style="display:flex;flex-direction:column;gap:6px;">
            ${matches.map((p) => `
              <a href="#/product/${p.id}" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px;border-radius:var(--r-md);">
                <div style="display:flex;align-items:center;gap:10px;">
                  <img src="${p.images[0]}" alt="" style="width:40px;height:40px;border-radius:8px;object-fit:cover;" />
                  <div>
                    <div style="font-size:var(--fs-14);font-weight:600;">${safeHighlight(trObj(p.title))}</div>
                    <div style="font-size:var(--fs-12);color:var(--muted);"><bdi>${escapeHTML(p.brand)}</bdi> · ★ ${formatNum(p.rating)}</div>
                  </div>
                </div>
                <span class="price-current" style="font-size:var(--fs-14);">${formatPrice(p.price)}</span>
              </a>
            `).join('')}
          </div>
        ` : `<div style="padding:10px;color:var(--muted);font-size:var(--fs-14);">${escapeHTML(t('resultsFound', { n: 0 }))}</div>`;
      };

      searchInput?.addEventListener('focus', () => {
        dropdown.classList.add('open');
        renderSuggestions(searchInput.value);
      });
      searchInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => renderSuggestions(searchInput.value), 140);
      });

      document.getElementById('header-search-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = searchInput.value.trim();
        dropdown?.classList.remove('open');
        if (q) {
          const hist = [q, ...Store.state.searchHistory.filter((x) => x !== q)].slice(0, 8);
          Store.set({ searchHistory: hist });
        }
        location.hash = `#/catalog?q=${encodeURIComponent(q)}`;
      });
    }

