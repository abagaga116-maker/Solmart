    function router(opts = {}) {
      const outlet = document.getElementById('main-content');
      if (!outlet) return;
      document.getElementById('mega-menu')?.classList.remove('open');
      document.getElementById('search-dropdown')?.classList.remove('open');

      const rawHash = location.hash.slice(1) || '/';
      const [pathPart, queryPart] = rawHash.split('?');
      const queryParams = new URLSearchParams(queryPart || '');

      let pageTitle = `Solmart — ${t('tagline')}`;

      if (pathPart === '/' || pathPart === '') {
        renderHomePage(outlet);
      } else if (pathPart === '/catalog') {
        pageTitle = `${t('catalog')} — Solmart`;
        renderCatalogPage(outlet, queryParams);
      } else if (pathPart === '/promotions') {
        pageTitle = `${t('dealsCoupons')} — Solmart`;
        queryParams.set('discount', 'true');
        renderCatalogPage(outlet, queryParams);
      } else if (pathPart === '/bestsellers') {
        pageTitle = `${t('bestsellers')} — Solmart`;
        queryParams.set('sort', 'popular');
        renderCatalogPage(outlet, queryParams);
      } else if (pathPart.startsWith('/product/')) {
        const pid = pathPart.replace('/product/', '');
        const pr = Store.state.products.find((x) => x.id === pid);
        if (pr) pageTitle = `${trObj(pr.title)} — Solmart`;
        renderProductPage(outlet, pid);
      } else if (pathPart === '/cart') {
        pageTitle = `${t('yourCart')} — Solmart`;
        renderCartPage(outlet);
      } else if (pathPart === '/checkout') {
        pageTitle = `${t('checkout')} — Solmart`;
        if (checkoutStep === 5) checkoutStep = 1;
        renderCheckoutPage(outlet);
      } else if (pathPart === '/favorites') {
        pageTitle = `${t('favorites')} — Solmart`;
        renderFavoritesPage(outlet);
      } else if (pathPart === '/compare') {
        pageTitle = `${t('compare')} — Solmart`;
        renderComparePage(outlet);
      } else if (pathPart === '/profile') {
        pageTitle = `${t('profile')} — Solmart`;
        renderProfilePage(outlet);
      } else if (pathPart === '/settings' || pathPart.startsWith('/settings/')) {
        pageTitle = `${t('settings')} — Solmart`;
        const sub = pathPart.replace('/settings/', '').replace('/settings', '');
        renderSettingsPage(outlet, sub);
      } else if (pathPart === '/seller-dashboard' || pathPart === '/sell') {
        pageTitle = `${t('sellerHub')} — Solmart`;
        renderSellerDashboard(outlet);
      } else if (pathPart.startsWith('/shop/')) {
        renderShopPage(outlet, pathPart.replace('/shop/', ''));
outlet.innerHTML = `
          <h1 class="section-title" style="margin-block-end:18px;">${escapeHTML(t('topSellers'))}</h1>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;">
            ${Store.state.shops.map((sh) => `
              <a href="#/shop/${sh.id}" class="card-box" style="display:flex;flex-direction:column;gap:10px;">
                <div style="height:64px;border-radius:var(--r-md);background:${sh.banner};display:flex;align-items:center;padding-inline:16px;color:#1B1B1F;font-weight:800;font-size:var(--fs-18);">
                  <bdi>${escapeHTML(sh.name)}</bdi>
                </div>
                <p style="color:var(--muted);font-size:var(--fs-14);">${escapeHTML(trObj(sh.desc))}</p>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:var(--fs-12);font-weight:700;">
                  <span>★ ${formatNum(sh.rating)} (${formatNum(sh.reviews)})</span>
                  <span class="badge badge-primary">${escapeHTML(t('viewAll'))}</span>
                </div>
              </a>
            `).join('')}
          </div>
        `;
      } else if (pathPart === '/brands') {
        pageTitle = `${t('topBrands')} — Solmart`;
        const brands = [...new Set(Store.state.products.map((p) => p.brand))].sort();
        outlet.innerHTML = `
          <h1 class="section-title" style="margin-block-end:18px;">${escapeHTML(t('topBrands'))}</h1>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;">
            ${brands.map((b) => `
              <a href="#/catalog?brands=${encodeURIComponent(b)}" class="card-box" style="text-align:center;padding:20px 12px;font-weight:800;font-size:var(--fs-16);">
                <bdi>${escapeHTML(b)}</bdi>
              </a>
            `).join('')}
          </div>
        `;
      } else if (pathPart === '/gift-cards') {
        pageTitle = `${t('giftCards')} — Solmart`;
        renderGiftCardsPage(outlet);
      } else if (pathPart === '/help') {
        pageTitle = `${t('helpCenter')} — Solmart`;
        renderHelpPage(outlet);
        enhanceHelpPageWithBot(outlet);
      } else if (pathPart.startsWith('/order/')) {
        const ordId = pathPart.replace('/order/', '');
        pageTitle = `${t('trackOrder')} #${ordId} — Solmart`;
        renderOrderTrackingPage(outlet, ordId);
      } else if (pathPart === '/auth') {
        openAuthModal();
        renderHomePage(outlet);
      } else {
        pageTitle = `404 — Solmart`;
        renderNotFoundPage(outlet);
      }

      // Post-render enhancements for Seller Hub, Profile & Settings
      if (pathPart === '/seller-dashboard' || pathPart === '/sell') {
        enhanceSellerDashboard(outlet);
      } else if (pathPart === '/profile') {
        enhanceProfileOrders(outlet);
      } else if (pathPart === '/settings' || pathPart.startsWith('/settings/')) {
        enhanceSettingsPanel(outlet);
      }

      // Fix any accidental class split in rendered buttons
      outlet.querySelectorAll('[class*="btn-"]').forEach((el) => {
        if (el.className.includes('\n')) {
          el.className = el.className.replace(/\s+/g, ' ').replace('btn- ghost', 'btn-ghost');
        }
      });

      document.title = pageTitle;
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) metaDesc.setAttribute('content', `${pageTitle} — ${t('tagline')}`);
      const ogTitle = document.querySelector('meta[property="og:title"]');
      if (ogTitle) ogTitle.setAttribute('content', pageTitle);

      if (!opts.preserveScroll) {
        window.scrollTo({ top: 0, behavior: 'instant' });
      }
      Motion.animatePageEnter(outlet);
      renderMobileTabbar();
      updateCompareFloatBar();
    }

