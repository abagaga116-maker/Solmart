      const closeBtn = document.getElementById('modal-close-btn');
      closeBtn?.focus();
      closeBtn?.addEventListener('click', closeModal);
      root.onclick = (e) => {
        if (e.target === root) closeModal();
      };

      // Swipe down to close on mobile bottom sheet
      const panel = document.getElementById('modal-panel-el');
      let startY = 0;
      panel?.addEventListener('touchstart', (e) => {
        if (panel.scrollTop <= 0) startY = e.touches[0].clientY;
      }, { passive: true });
      panel?.addEventListener('touchend', (e) => {
        if (startY > 0 && e.changedTouches[0].clientY - startY > 95 && panel.scrollTop <= 0) {
          closeModal();
        }
        startY = 0;
      }, { passive: true });
    }

