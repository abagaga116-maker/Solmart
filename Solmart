                <div><strong>${escapeHTML(t('deliverTo'))}:</strong> ${escapeHTML(checkoutDraft.address)}</div>
                <div><strong>${escapeHTML(t('shipping'))}:</strong> ${escapeHTML(t(checkoutDraft.deliveryMethod === 'courier' ? 'delivCourier' : (checkoutDraft.deliveryMethod === 'locker' ? 'delivLocker' : 'delivStandard')))}</div>
