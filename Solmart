                <span class="switch"><input type="checkbox" id="filter-fast" ${filterState.fastDelivery ? 'checked' : ''} /><span class="switch-slider"></span></span>
              </label>
            </div>

            <div style="margin-block-end:16px;">
              <label class="field-label">${escapeHTML(t('brand'))}</label>
              <div style="max-height:170px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;">
                ${allBrands.map((b) => `
                  <label style="display:flex;align-items:center;gap:8px;font-size:var(--fs-14);cursor:pointer;">
                    <input type="checkbox" value="${escapeHTML(b)}" class="filter-brand-cb" ${filterState.brands.includes(b) ? 'checked' : ''} />
                    <bdi>${escapeHTML(b)}</bdi>
                  </label>
                `).join('')}
              </div>
            </div>

            <button type="button" class="btn btn-primary only-mobile" id="close-mobile-filters-btn" style="width:100%;">
              ${escapeHTML(t('showFilteredCount', { n: formatNum(filtered.length) }))}
            </button>
          </aside>

          <div>
            <!-- Active filter chips -->
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-block-end:12px;">
              ${filterState.q ? `<button type="button" class="badge badge-primary" id="clear-q-chip">“${escapeHTML(filterState.q)}” ×</button>` : ''}
              ${filterState.discountOnly ? `<button type="button" class="badge badge-discount" id="clear-disc-chip">${escapeHTML(t('discountOnly'))} ×</button>` : ''}
              ${filterState.fastDelivery ? `<button type="button" class="badge badge-success" id="clear-fast-chip">${escapeHTML(t('fastDelivery'))} ×</button>` : ''}
              ${filterState.brands.map((b) => `<button type="button" class="badge badge-muted" data-remove-brand="${escapeHTML(b)}"><bdi>${escapeHTML(b)}</bdi> ×</button>`).join('')}
            </div>

            ${filtered.length ? `
              <div class="product-grid ${filterState.viewMode === 'list' ? 'list-view' : (filterState.viewMode === 'large' ? 'large-view' : '')}" id="catalog-grid">
                ${filtered.map((p) => renderProductCard(p)).join('')}
              </div>
            ` : `
              <div class="card-box" style="text-align:center;padding:44px 20px;">
                <h2 style="font-size:var(--fs-20);margin-block-end:8px;">${escapeHTML(t('resultsFound', { n: 0 }))}</h2>
                <p style="color:var(--muted);margin-block-end:16px;">${escapeHTML(t('noResultsHint'))}</p>
                <button type="button" class="btn btn-primary" id="empty-reset-btn">${escapeHTML(t('resetFilters'))}</button>
              </div>
            `}
          </div>
        </div>
      `;

      document.getElementById('catalog-sort-select')?.addEventListener('change', (e) => {
        filterState.sort = e.target.value;
        syncUrlAndRerender();
      });
      document.getElementById('toggle-view-mode')?.addEventListener('click', () => {
        const nextView = s.catalogView === 'grid' ? 'list' : 'grid';
        Store.set({ catalogView: nextView });
        syncUrlAndRerender();
      });
      document.getElementById('filter-category-select')?.addEventListener('change', (e) => {
        filterState.category = e.target.value;
        syncUrlAndRerender();
      });
      document.getElementById('filter-min-price')?.addEventListener('change', (e) => {
        filterState.minPrice = Math.max(0, Number(e.target.value) || 0);
        syncUrlAndRerender();
      });
      document.getElementById('filter-max-price')?.addEventListener('change', (e) => {
        filterState.maxPrice = Math.max(10, Number(e.target.value) || 1500);
        syncUrlAndRerender();
      });
      document.getElementById('filter-discount')?.addEventListener('change', (e) => {
        filterState.discountOnly = e.target.checked;
        syncUrlAndRerender();
      });
      document.getElementById('filter-stock')?.addEventListener('change', (e) => {
        filterState.inStockOnly = e.target.checked;
        syncUrlAndRerender();
      });
      document.getElementById('filter-fast')?.addEventListener('change', (e) => {
        filterState.fastDelivery = e.target.checked;
        syncUrlAndRerender();
      });
      outlet.querySelectorAll('.filter-brand-cb').forEach((cb) => {
        cb.addEventListener('change', () => {
          const val = cb.value;
          if (cb.checked) filterState.brands.push(val);
          else filterState.brands = filterState.brands.filter((x) => x !== val);
          syncUrlAndRerender();
        });
      });

      const resetAll = () => {
        history.replaceState(null, '', '#/catalog');
        renderCatalogPage(outlet, new URLSearchParams());
      };
      document.getElementById('reset-catalog-filters')?.addEventListener('click', resetAll);
      document.getElementById('empty-reset-btn')?.addEventListener('click', resetAll);
      document.getElementById('clear-q-chip')?.addEventListener('click', () => { filterState.q = ''; syncUrlAndRerender(); });
      document.getElementById('clear-disc-chip')?.addEventListener('click', () => { filterState.discountOnly = false; syncUrlAndRerender(); });
      document.getElementById('clear-fast-chip')?.addEventListener('click', () => { filterState.fastDelivery = false; syncUrlAndRerender(); });
      outlet.querySelectorAll('[data-remove-brand]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const b = btn.getAttribute('data-remove-brand');
          filterState.brands = filterState.brands.filter((x) => x !== b);
          syncUrlAndRerender();
        });
      });

      const sidebar = document.getElementById('catalog-sidebar');
      document.getElementById('mobile-filter-open')?.addEventListener('click', () => sidebar?.classList.add('mobile-open'));
      document.getElementById('close-mobile-filters-btn')?.addEventListener('click', () => sidebar?.classList.remove('mobile-open'));
    }

    /* ==========================================================================
       MODULE 10: PRODUCT DETAIL PAGE (GALLERY, SVG PRICE CHART, REVIEWS, STICKY)
       ========================================================================== */
    function renderProductPage(outlet, productId) {
      const s = Store.state;
      const lang = s.lang;
      const product = s.products.find((p) => p.id === productId) || s.products[0];
      if (!product) return;

      if (!s.recentlyViewed.includes(product.id)) {
        Store.set({ recentlyViewed: [product.id, ...s.recentlyViewed].slice(0, 12) });
      }

      // Update SEO JSON-LD in user's selected currency
      const jsonLdEl = document.getElementById('jsonld-product');
      if (jsonLdEl) {
        const cfg = CURRENCY_RATES[s.currency] || CURRENCY_RATES.USD;
        jsonLdEl.textContent = JSON.stringify({
          '@context': 'https://schema.org/',
          '@type': 'Product',
          name: trObj(product.title),
          brand: { '@type': 'Brand', name: product.brand },
          sku: product.sku,
          offers: {
            '@type': 'Offer',
            priceCurrency: s.currency,
            price: (product.price * cfg.rate).toFixed(cfg.decimals),
            availability: product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock'
          },
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: product.rating,
            reviewCount: product.reviewCount
          }
        });
      }

      let selectedColor = product.colors[0];
      let selectedSize = product.sizes[0];
      let activeTab = 'desc';

      const renderView = () => {
        const prodReviews = Store.state.reviews.filter((r) => r.productId === product.id);
        const prodQuestions = Store.state.questions.filter((q) => q.productId === product.id);
        const similar = Store.state.products.filter((p) => p.category === product.category && p.id !== product.id).slice(0, 6);
        const companion = similar[0] || Store.state.products[1];
        const inWish = Store.state.wishlist.includes(product.id);
        const priceSubscribed = Store.state.priceAlerts.includes(product.id);

        const pBase = product.price;
        const pts = [pBase * 1.18, pBase * 1.12, pBase * 1.22, pBase * 1.08, pBase * 1.05, pBase];
        const maxP = Math.max(...pts) * 1.05;
        const minP = Math.min(...pts) * 0.9;
        const svgCoords = pts.map((v, i) => {
          const x = 20 + i * 52;
          const y = 90 - ((v - minP) / (maxP - minP)) * 65;
          return `${x},${Math.round(y)}`;
        }).join(' ');

        const specsObj = trObj(product.specs) || product.specs.en;

        outlet.innerHTML = `
          <nav aria-label="Breadcrumb" style="font-size:var(--fs-12);color:var(--muted);margin-block-end:14px;display:flex;gap:6px;flex-wrap:wrap;">
            <a href="#/">${escapeHTML(t('home'))}</a> <span>/</span>
            <a href="#/catalog?category=${product.category}">${escapeHTML(CATEGORIES.find((c) => c.id === product.category)?.[lang] || product.category)}</a>
            <span>/</span> <strong style="color:var(--text);">${escapeHTML(trObj(product.title))}</strong>
          </nav>

          <div class="pdp-grid">
            <!-- Gallery -->
            <div>
              <div style="border-radius:var(--r-xl);overflow:hidden;border:1px solid var(--border);background:var(--surface);aspect-ratio:1/1;margin-block-end:10px;cursor:zoom-in;" id="pdp-main-img-wrap">
                <img id="pdp-main-img" src="${product.images[0]}" alt="${escapeHTML(trObj(product.title))}" style="width:100%;height:100%;object-fit:cover;" />
              </div>
              <div style="display:flex;gap:8px;">
                ${product.images.map((img, i) => `
                  <button type="button" class="pdp-thumb-btn" data-img="${img}" style="width:68px;height:68px;border-radius:var(--r-md);overflow:hidden;border:2px solid ${i === 0 ? 'var(--primary)' : 'var(--border)'};">
                    <img src="${img}" alt="" style="width:100%;height:100%;object-fit:cover;" />
                  </button>
                `).join('')}
              </div>
            </div>

            <!-- Center Variants & Price Chart -->
            <div>
              <div style="display:flex;align-items:center;gap:8px;margin-block-end:8px;flex-wrap:wrap;">
                <span class="badge badge-primary"><bdi>${escapeHTML(product.brand)}</bdi></span>
                <span class="rating-pill">${icon('star', 14)} ${formatNum(product.rating)} (${tp('reviews', product.reviewCount)})</span>
                <span style="font-size:var(--fs-12);color:var(--muted);">SKU: <bdi>${escapeHTML(product.sku)}</bdi></span>
              </div>

              <h1 style="font-size:var(--fs-24);margin-block-end:12px;">${escapeHTML(trObj(product.title))}</h1>

              <div style="margin-block-end:14px;">
                <span class="field-label">${escapeHTML(t('colorLabel'))}</span>
                <div style="display:flex;gap:10px;">
                  ${product.colors.map((c) => `
                    <button type="button" class="color-swatch-btn" data-color="${c}" aria-label="${c}"
                            style="width:36px;height:36px;border-radius:50%;background:${c};border:3px solid ${selectedColor === c ? 'var(--primary)' : 'var(--border)'};"></button>
                  `).join('')}
                </div>
              </div>

              <div style="margin-block-end:16px;">
                <span class="field-label">${escapeHTML(t('sizeLabel'))}</span>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                  ${product.sizes.map((sz) => `
                    <button type="button" class="btn btn-sm ${selectedSize === sz ? 'btn-primary' : 'btn-secondary'} size-opt-btn" data-size="${escapeHTML(sz)}">${escapeHTML(sz)}</button>
                  `).join('')}
                </div>
              </div>

              <div class="card-box" style="margin-block-end:14px;padding:14px;">
                <div style="font-weight:700;font-size:var(--fs-14);margin-block-end:8px;">${escapeHTML(t('specifications'))}</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:var(--fs-12);">
                  ${Object.entries(specsObj).map(([k, v]) => `
                    <div><span style="color:var(--muted);">${escapeHTML(k)}:</span> <strong>${escapeHTML(v)}</strong></div>
                  `).join('')}
                </div>
              </div>

              <!-- 6-Month SVG Price Chart (LTR axis preserved) -->
              <div class="card-box" style="padding:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-block-end:6px;flex-wrap:wrap;gap:6px;">
                  <span style="font-size:var(--fs-12);font-weight:700;">${escapeHTML(t('priceHistory'))} (${formatPrice(minP)} –${formatPrice(maxP)})</span>
                  <button type="button" class="badge ${priceSubscribed ? 'badge-success' : 'badge-muted'}" id="price-alert-btn" style="cursor:pointer;">
                    ${icon('bell', 12)} <span>${escapeHTML(t(priceSubscribed ? 'priceAlertActive' : 'trackPriceBtn'))}</span>
                  </button>
                </div>
                <svg dir="ltr" viewBox="0 0 300 105" style="width:100%;height:72px;overflow:visible;">
                  <polyline fill="none" stroke="var(--primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="${svgCoords}" />
                  <circle cx="280" cy="${svgCoords.split(' ').pop().split(',')[1]}" r="5" fill="var(--primary)" />
                </svg>
                <div style="font-size:var(--fs-12);color:var(--success);font-weight:600;">
                  ${escapeHTML(t('lowestPriceNote'))}
                </div>
              </div>
            </div>

            <!-- Buy Box -->
            <div class="card-box pdp-buybox">
              <div style="display:flex;align-items:baseline;gap:8px;margin-block-end:6px;flex-wrap:wrap;">
                <span class="price-current" style="font-size:var(--fs-32);">${formatPrice(product.price)}</span>
                <span class="price-old" style="font-size:var(--fs-16);">${formatPrice(product.oldPrice)}</span>
                <span class="badge badge-discount">−${formatNum(product.discount)}%</span>
              </div>

              <div style="font-size:var(--fs-12);color:var(--primary-strong);font-weight:700;margin-block-end:14px;">
                ${escapeHTML(t('cashbackNote', { n: formatNum(Math.round(product.price * 0.05)) }))}
              </div>

              <div style="display:flex;flex-direction:column;gap:8px;font-size:var(--fs-14);margin-block-end:16px;padding:12px;background:var(--bg);border-radius:var(--r-md);">
                <div style="display:flex;align-items:center;gap:8px;">
                  ${icon('truck', 18)}
                  <span>${escapeHTML(t('expressGuarantee'))}: <strong>${product.deliveryDays === 1 ? escapeHTML(t('deliveryTomorrow')) : escapeHTML(t('deliveryDays', { n: formatNum(product.deliveryDays) }))}</strong></span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  ${icon('shield', 18)}
                  <span>${escapeHTML(t('returnGuarantee'))}</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  ${icon('store', 18)}
                  <span>${escapeHTML(t('soldBy'))}: <a href="#/shop/${product.sellerId}" style="font-weight:700;text-decoration:underline;"><bdi>${escapeHTML(product.seller)}</bdi></a></span>
                </div>
              </div>

              <div style="display:flex;flex-direction:column;gap:10px;">
                <button type="button" class="btn btn-primary btn-lg" data-action="add-to-cart" data-id="${product.id}">
                  ${icon('cart', 19)} <span>${escapeHTML(t('addToCart'))}</span>
                </button>
                <button type="button" class="btn btn-secondary btn-lg" id="pdp-buy-now">
                  ${icon('bolt', 19)} <span>${escapeHTML(t('buyNow'))}</span>
                </button>
              </div>

              <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px;margin-block-start:12px;padding-block-start:10px;border-block-start:1px solid var(--border);">
                <button type="button" class="btn btn-
ghost btn-sm" data-action="toggle-wish" data-id="${product.id}">
                  ${icon('heart', 16)} <span>${escapeHTML(t('favorites'))}</span>
                </button>
                <button type="button" class="btn btn-ghost btn-sm" data-action="toggle-compare" data-id="${product.id}">
                  ${icon('scale', 16)} <span>${escapeHTML(t('compare'))}</span>
                </button>
                <button type="button" class="btn btn-ghost btn-sm" id="pdp-share-btn">
                  ${icon('share', 16)} <span>${escapeHTML(t('shareBtn'))}</span>
                </button>
                <button type="button" class="btn btn-ghost btn-sm" id="pdp-report-btn" style="color:var(--muted);">
                  ${icon('flag', 15)} <span>${escapeHTML(t('reportProduct'))}</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Frequently Bought Together -->
          <section class="section-block" style="margin-block-start:32px;">
            <div class="card-box" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px;">
              <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                <img src="${product.images[0]}" alt="" style="width:70px;height:70px;border-radius:12px;object-fit:cover;" />
                <span style="font-size:var(--fs-24);font-weight:800;">+</span>
                <img src="${companion.images[0]}" alt="" style="width:70px;height:70px;border-radius:12px;object-fit:cover;" />
                <div>
                  <h2 style="font-size:var(--fs-18);">${escapeHTML(t('frequentlyBought'))}</h2>
                  <p style="font-size:var(--fs-14);color:var(--muted);">${escapeHTML(trObj(product.title))} + ${escapeHTML(trObj(companion.title))}</p>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                <div>
                  <div class="price-current">${formatPrice(Math.round((product.price + companion.price) * 0.92))}</div>
                  <div class="price-old">${formatPrice(product.price + companion.price)}</div>
                </div>
                <button type="button" class="btn btn-primary" id="add-bundle-btn">${escapeHTML(t('addBundle'))}</button>
              </div>
            </div>
          </section>

          <!-- Product Tabs (Description, Specs, Reviews, Q&A, Delivery) -->
          <section class="section-block">
            <div role="tablist" style="display:flex;gap:6px;border-block-end:1px solid var(--border);margin-block-end:18px;overflow-x:auto;">
              ${[
                ['desc', t('description')],
                ['specs', t('specifications')],
                ['reviews', `${t('reviews')} (${formatNum(prodReviews.length)})`],
                ['qna', `${t('qna')} (${formatNum(prodQuestions.length)})`],
                ['delivery', t('deliveryReturns')]
              ].map(([id, label]) => `
                <button type="button" role="tab" aria-selected="${activeTab === id}" class="btn ${activeTab === id ? 'btn-primary' : 'btn-ghost'} pdp-tab-btn" data-tab="${id}" style="border-radius:var(--r-md) var(--r-md) 0 0;">
                  ${escapeHTML(label)}
                </button>
              `).join('')}
            </div>

            <div class="card-box" id="pdp-tab-panel" role="tabpanel">
              ${activeTab === 'desc' ? `
                <p style="font-size:var(--fs-16);max-width:780px;">${escapeHTML(trObj(product.description))}</p>
              ` : ''}

              ${activeTab === 'specs' ? `
                <div class="table-wrap">
                  <table class="data-table">
                    <tbody>
                      ${Object.entries(specsObj).map(([k, v]) => `<tr><th>${escapeHTML(k)}</th><td>${escapeHTML(v)}</td></tr>`).join('')}
                    </tbody>
                  </table>
                </div>
              ` : ''}

              ${activeTab === 'reviews' ? `
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;">
                  <div>
                    <div class="tabular" style="font-size:var(--fs-32);font-weight:800;">★ ${formatNum(product.rating)} / ${formatNum(5)}</div>
                    <p style="color:var(--muted);font-size:var(--fs-14);margin-block-end:14px;">${escapeHTML(tp('reviews', product.reviewCount))}</p>
                    <form id="new-review-form" style="display:flex;flex-direction:column;gap:10px;">
                      <h3 style="font-size:var(--fs-16);">${escapeHTML(t('writeReview'))}</h3>
                      <select class="select" name="rating" required aria-label="${escapeHTML(t('minRating'))}">
                        <option value="5">★★★★★ (5/5)</option>
                        <option value="4">★★★★☆ (4/5)</option>
                        <option value="3">★★★☆☆ (3/5)</option>
                        <option value="2">★★☆☆☆ (2/5)</option>
                      </select>
                      <textarea class="textarea" name="text" required placeholder="${escapeHTML(t('reviewPlaceholder'))}"></textarea>
                      <button type="submit" class="btn btn-primary">${escapeHTML(t('writeReview'))}</button>
                    </form>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:12px;">
                    ${prodReviews.length ? prodReviews.map((r) => `
                      <div style="padding:14px;border:1px solid var(--border);border-radius:var(--r-md);">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-block-end:6px;gap:8px;flex-wrap:wrap;">
                          <strong>${escapeHTML(r.user)} <span class="badge badge-success">${escapeHTML(t('verifiedBadge'))}</span></strong>
                          <span style="color:#F59E0B;font-weight:700;">${'★'.repeat(r.rating)}</span>
                        </div>
                        <p style="font-size:var(--fs-14);margin-block-end:8px;">${escapeHTML(r.text)}</p>
                        <div style="display:flex;justify-content:space-between;align-items:center;font-size:var(--fs-12);color:var(--muted);">
                          <span>${escapeHTML(r.date)}</span>
                          <button type="button" class="btn btn-ghost btn-sm helpful-rev-btn" data-rev-id="${r.id}">
                            👍 ${escapeHTML(t('helpfulBtn'))} (${formatNum(r.helpful || 0)})
                          </button>
                        </div>
                        ${r.reply ? `<div style="margin-block-start:8px;padding:8px 12px;background:var(--bg);border-inline-start:3px solid var(--primary);font-size:var(--fs-12);"><strong><bdi>${escapeHTML(product.seller)}</bdi>:</strong> ${escapeHTML(r.reply)}</div>` : ''}
                      </div>
                    `).join('') : `<p style="color:var(--muted);">${escapeHTML(t('noReviewsYet'))}</p>`}
                  </div>
                </div>
              ` : ''}

              ${activeTab === 'qna' ? `
                <div style="display:flex;flex-direction:column;gap:12px;">
                  ${prodQuestions.map((q) => `
                    <div style="padding:12px;border:1px solid var(--border);border-radius:var(--r-md);">
                      <div style="font-weight:700;margin-block-end:4px;">Q: ${escapeHTML(q.question)}</div>
                      <div style="font-size:var(--fs-14);color:var(--muted);">A (<bdi>${escapeHTML(product.seller)}</bdi>): ${escapeHTML(q.answer)}</div>
                    </div>
                  `).join('')}
                  <form id="ask-q-form" style="display:flex;gap:8px;margin-block-start:8px;flex-wrap:wrap;">
                    <input class="input" name="question" required placeholder="${escapeHTML(t('questionPlaceholder'))}" style="flex:1;min-width:220px;" />
                    <button type="submit" class="btn btn-primary">${escapeHTML(t('askQuestion'))}</button>
                  </form>
                </div>
              ` : ''}

              ${activeTab === 'delivery' ? `
                <p style="font-size:var(--fs-14);">${escapeHTML(t('deliveryTabInfo'))}</p>
              ` : ''}
            </div>
          </section>

          <!-- Similar Products -->
          <section class="section-block">
            <h2 class="section-title" style="margin-block-end:14px;">${escapeHTML(t('similarProducts'))}</h2>
            <div class="product-grid">
              ${similar.map((p) => renderProductCard(p)).join('')}
            </div>
          </section>

          <!-- Sticky Buy Bar -->
          <div class="sticky-buy-bar" id="sticky-pdp-bar">
            <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                <img src="${product.images[0]}" alt="" style="width:42px;height:42px;border-radius:8px;object-fit:cover;flex-shrink:0;" />
                <div style="min-width:0;">
                  <div style="font-weight:700;font-size:var(--fs-14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHTML(trObj(product.title))}</div>
                  <div class="price-current" style="font-size:var(--fs-16);">${formatPrice(product.price)}</div>
