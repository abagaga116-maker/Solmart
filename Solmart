    function initHeroCarousel(total) {
      clearInterval(heroInterval);
      const carousel = document.getElementById('hero-carousel-el');
      if (!carousel) return;

      const updateSlide = (idx) => {
        heroSlideIndex = (idx + total) % total;
        carousel.querySelectorAll('.hero-slide').forEach((el, i) => el.classList.toggle('active', i === heroSlideIndex));
        carousel.querySelectorAll('.hero-dot').forEach((el, i) => el.classList.toggle('active', i === heroSlideIndex));
      };

      document.getElementById('hero-prev')?.addEventListener('click', () => updateSlide(heroSlideIndex - 1));
      document.getElementById('hero-next')?.addEventListener('click', () => updateSlide(heroSlideIndex + 1));
      carousel.querySelectorAll('[data-dot-idx]').forEach((dot) => {
        dot.addEventListener('click', () => updateSlide(Number(dot.getAttribute('data-dot-idx'))));
      });

      // Touch swipe support (RTL aware)
      let touchStartX = 0;
      carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        clearInterval(heroInterval);
      }, { passive: true });
      carousel.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) {
          const step = (dx < 0 ? 1 : -1) * Motion.dirFactor();
          updateSlide(heroSlideIndex + step);
        }
        startAuto();
      }, { passive: true });

      const startAuto = () => {
        clearInterval(heroInterval);
        heroInterval = setInterval(() => {
          if (!document.hidden) updateSlide(heroSlideIndex + 1);
        }, 6000);
      };
      carousel.addEventListener('mouseenter', () => clearInterval(heroInterval));
      carousel.addEventListener('mouseleave', startAuto);
      startAuto();
    }

