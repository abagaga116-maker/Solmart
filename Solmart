    /* ==========================================================================
       MODULE 5: TRANSLATION, PLURALIZATION, 18-CURRENCY FORMATTER & HELPERS
       ========================================================================== */
    function t(key, vars = {}) {
      const lang = Store.state?.lang || 'en';
      let str = DICT[lang]?.[key] ?? DICT.en[key] ?? key;
      Object.entries(vars).forEach(([k, v]) => {
        str = str.replaceAll(`{${k}}`, v);
      });
      return str;
    }

    function tp(key, count) {
      const lang = Store.state?.lang || 'en';
      const forms = PLURAL_FORMS[lang]?.[key] || PLURAL_FORMS.en[key];
      if (!forms) return `${count}`;
      let cat = 'other';
      try {
        cat = new Intl.PluralRules(lang).select(count);
      } catch (e) {}
      const tpl = forms[cat] || forms.other || '{n}';
      return tpl.replaceAll('{n}', formatNum(count));
    }

    function trObj(obj) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      const lang = Store.state?.lang || 'en';
      return obj[lang] || obj.en || Object.values(obj)[0] || '';
    }

    function getNumberingSystem() {
      return Store.state?.numerals === 'arab' ? 'arab' : 'latn';
    }

    function formatNum(n) {
      const lang = Store.state?.lang || 'en';
      try {
        return new Intl.NumberFormat(`${lang}-u-nu-${getNumberingSystem()}`).format(Number(n || 0));
      } catch (e) {
        return String(n);
      }
    }

    function formatPrice(usdAmount, opts = {}) {
      const curr = opts.forceCurrency || Store.state?.currency || 'USD';
      const cfg = CURRENCY_RATES[curr] || CURRENCY_RATES.USD;
      const isNegative = Number(usdAmount) < 0;
      const absUsd = Math.abs(Number(usdAmount || 0));
      let rawConverted = absUsd * cfg.rate;

      // Pretty rounding for display prices on high-rate currencies when not in exact cart/checkout mode
      if (!opts.exact && cfg.rate >= 25 && rawConverted >= 100) {
        rawConverted = Math.ceil(rawConverted / 10) * 10;
      }

      const decimals = opts.exact && cfg.decimals === 0 ? 0 : cfg.decimals;
      const nu = getNumberingSystem();
      const localeWithNu = `${cfg.locale}-u-nu-${nu}`;

      try {
        const formatted = new Intl.NumberFormat(localeWithNu, {
          style: 'currency',
          currency: curr,
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
          notation: opts.compact && rawConverted >= 1000000 ? 'compact' : 'standard'
        }).format(rawConverted);
        return isNegative ? `−${formatted}` : formatted;
      } catch (e) {
        const fixed = rawConverted.toFixed(decimals);
        return `${isNegative ? '−' : ''}${fixed}\u00A0${cfg.symbol}`;
      }
    }

    function formatDate(ts) {
      const s = Store.state;
      const d = new Date(ts);
      const locale = s.lang === 'ar' ? 'ar-EG' : (s.lang === 'ru' ? 'ru-RU' : 'en-US');
      try {
        return new Intl.DateTimeFormat(`${locale}-u-nu-${getNumberingSystem()}`, {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }).format(d);
      } catch (e) {
        return d.toLocaleDateString();
      }
    }

    function triggerHaptic(ms = 12) {
      if (Store.state?.haptic && typeof navigator.vibrate === 'function') {
        try { navigator.vibrate(ms); } catch (e) {}
      }
    }

    function announce(msg) {
      const region = document.getElementById('aria-live-announcer');
      if (region) region.textContent = msg;
    }

    function showToast(message, type = 'info', actionLabel = null, actionCallback = null) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      // Limit queue to max 2 simultaneous toasts
      while (container.children.length >= 2) {
        container.firstElementChild.remove();
      }
      const dur = Store.state?.toastDuration || 3600;
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      toast.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;font-size:var(--fs-14);font-weight:600;">
          <span>${escapeHTML(message)}</span>
        </div>
        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
          ${actionLabel ? `<button type="button" class="btn btn-sm btn-primary toast-action-btn">${escapeHTML(actionLabel)}</button>` : ''}
          <button type="button" class="icon-btn toast-close-btn" style="width:28px;height:28px;" aria-label="${escapeHTML(t('clear'))}">${icon('x', 15)}</button>
        </div>
      `;
      container.appendChild(toast);
      announce(message);

      Motion.animate(toast, {
        translateX: [Motion.dirFactor() * 32, 0],
        opacity: [0, 1],
        duration: 220,
        easing: 'easeOutCubic'
      });

      const close = () => toast.remove();
      const timer = setTimeout(close, dur);
      toast.querySelector('.toast-close-btn')?.addEventListener('click', () => {
        clearTimeout(timer);
        close();
      });
      if (actionLabel && actionCallback) {
        toast.querySelector('.toast-action-btn')?.addEventListener('click', () => {
          clearTimeout(timer);
          actionCallback();
          close();
        });
      }
    }

    function setThemeAnimated(newTheme, originEvent = null) {
      const apply = () => Store.set({ theme: newTheme });
      if (document.startViewTransition && !Motion.isReduced() && originEvent) {
        const x = originEvent.clientX ?? window.innerWidth / 2;
        const y = originEvent.clientY ?? 36;
        const endRadius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
        const transition = document.startViewTransition(apply);
        transition.ready.then(() => {
          document.documentElement.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`] },
            { duration: 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' }
          );
        }).catch(() => {});
      } else {
        apply();
      }
    }

