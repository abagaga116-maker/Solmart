              <h2 style="font-size:var(--fs-18);">${escapeHTML(t('supportBotTitle'))}</h2>
            </div>
            <div id="bot-messages-list" style="display:flex;flex-direction:column;gap:8px;max-height:240px;overflow-y:auto;padding:12px;background:var(--bg);border-radius:var(--r-md);margin-block-end:12px;">
              ${botChatMessages.map((m) => `
                <div style="align-self:${m.sender === 'user' ? 'flex-end' : 'flex-start'};background:${m.sender === 'user' ? 'var(--primary)' : 'var(--surface)'};color:${m.sender === 'user' ? '#1B1B1F' : 'var(--text)'};padding:8px 12px;border-radius:12px;max-width:82%;font-size:var(--fs-14);border:1px solid var(--border);">
                  ${escapeHTML(m.text)}
                </div>
              `).join('')}
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-block-end:10px;">
              ${['SOL10', t('shipping'), t('deliveryReturns'), t('sellOnSolmart')].map((chip) => `
                <button type="button" class="badge badge-muted bot-quick-ask" data-ask="${escapeHTML(chip)}" style="cursor:pointer;padding:6px 10px;">
                  ${escapeHTML(chip)}
                </button>
              `).join('')}
            </div>
            <form id="bot-chat-form" style="display:flex;gap:8px;">
              <input class="input" name="q" required placeholder="${escapeHTML(t('botInputPlaceholder'))}" />
              <button type="submit" class="btn btn-primary">${escapeHTML(t('sendBtn'))}</button>
            </form>
          </div>
        `;

        const replyToUser = (userText) => {
          botChatMessages.push({ sender: 'user', text: userText });
          const low = normalizeArabic(userText);
          let reply = t('botReplyDefault');
          if (low.includes('deliv') || low.includes('ship') || low.includes('достав') || low.includes('توصيل') || low.includes('شحن')) {
            reply = t('botReplyDelivery');
          } else if (low.includes('return') || low.includes('refund') || low.includes('возврат') || low.includes('استرجاع')) {
            reply = t('botReplyReturn');
          } else if (low.includes('sol10') || low.includes('promo') || low.includes('промо') || low.includes('скидк') || low.includes('خصم')) {
            reply = t('botReplyPromo');
          } else if (low.includes('sell') || low.includes('продав') || low.includes('بائع') || low.includes('بيع')) {
            reply = t('botReplySeller');
          }
          botChatMessages.push({ sender: 'bot', text: reply });
          renderBotBox();
          const listEl = botWrap.querySelector('#bot-messages-list');
          if (listEl) listEl.scrollTop = listEl.scrollHeight;
        };

        botWrap.querySelectorAll('.bot-quick-ask').forEach((btn) => {
          btn.addEventListener('click', () => replyToUser(btn.getAttribute('data-ask')));
        });
        botWrap.querySelector('#bot-chat-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = String(new FormData(e.target).get('q') || '').trim();
          if (q) replyToUser(q);
        });
      };

      renderBotBox();
      outlet.appendChild(botWrap);
    }

    function renderOrderTrackingPage(outlet, orderId) {
      const s = Store.state;
      const ord = s.orders.find((o) => o.id === orderId) || s.orders[0];
      if (!ord) {
        location.hash = '#/profile';
        return;
      }
      const steps = [
        { key: 'ordered', label: t('timelineOrdered'), done: true },
        { key: 'packing', label: t('timelinePacking'), done: ['packing', 'shipped', 'delivered'].includes(ord.status) },
        { key: 'shipped', label: t('timelineShipped'), done: ['shipped', 'delivered'].includes(ord.status) },
        { key: 'delivered', label: t('timelineDelivered'), done: ord.status === 'delivered' }
      ];

      outlet.innerHTML = `
        <div style="max-width:680px;margin-inline:auto;">
          <div style="margin-block-end:14px;">
            <a href="#/profile" class="btn btn-ghost btn-sm">${icon('chevronLeft', 16)} <span>${escapeHTML(t('myOrders'))}</span></a>
          </div>
          <div class="card-box">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-block-end:16px;">
              <div>
                <h1 style="font-size:var(--fs-20);">${escapeHTML(t('trackOrder'))} <bdi>#${escapeHTML(ord.id)}</bdi></h1>
                <div style="font-size:var(--fs-12);color:var(--muted);">${escapeHTML(formatDate(ord.date))} · ${escapeHTML(ord.address)}</div>
              </div>
              <span class="badge ${ord.status === 'delivered' ? 'badge-success' : 'badge-primary'}">${escapeHTML(getOrderStatusLabel(ord.status))}</span>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-block-end:20px;">
              ${steps.map((st, idx) => `
                <div class="card-box" style="padding:12px;border-color:${st.done ? 'var(--primary)' : 'var(--border)'};background:${st.done ? 'rgba(255,106,46,0.08)' : 'var(--surface)'};">
                  <div style="font-weight:800;font-size:var(--fs-12);color:${st.done ? 'var(--primary-strong)' : 'var(--muted)'};margin-block-end:4px;">
                    ${formatNum(idx + 1)}. ${st.done ? '✓' : '○'}
                  </div>
                  <div style="font-weight:700;font-size:var(--fs-14);">${escapeHTML(st.label)}</div>
                </div>
              `).join('')}
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;padding-block-start:12px;border-block-start:1px solid var(--border);">
              <div class="price-current">${escapeHTML(t('total'))}: ${formatPrice(ord.totalUsd, { exact: true })}</div>
              ${ord.status !== 'delivered' && ord.status !== 'returned' ? `
                <button type="button" class="btn btn-primary btn-sm" id="track-advance-btn">${escapeHTML(t('advanceOrderBtn'))}</button>
              ` : ''}
            </div>
          </div>
        </div>
      `;

      document.getElementById('track-advance-btn')?.addEventListener('click', () => {
        const nextMap = { packing: 'shipped', shipped: 'delivered' };
        const nextSt = nextMap[ord.status] || 'delivered';
        Store.set({
          orders: s.orders.map((o) => o.id === ord.id ? { ...o, status: nextSt } : o)
        });
        showToast(t('orderAdvancedToast', { status: getOrderStatusLabel(nextSt) }), 'success');
        renderOrderTrackingPage(outlet, ord.id);
      });
    }

    function enhanceProfileOrders(outlet) {
      outlet.querySelectorAll('[data-order-id]').forEach((btn) => {
        const card = btn.closest('div[style*="border:1px solid"]');
        const strongEl = card?.querySelector('strong');
        const ordId = btn.getAttribute('data-order-id');
        if (strongEl && ordId && !strongEl.querySelector('a')) {
          strongEl.innerHTML = `<a href="#/order/${escapeHTML(ordId)}" style="text-decoration:underline;color:var(--primary-strong);"><bdi>#${escapeHTML(ordId)}</bdi></a>`;
        }
      });
    }

    function enhanceSellerDashboard(outlet) {
      const s = Store.state;
      const ordBox = document.createElement('div');
      ordBox.className = 'card-box table-wrap';
      ordBox.style.marginBlockStart = '20px';
      ordBox.innerHTML = `
        <h2 style="font-size:var(--fs-18);margin-block-end:12px;">${escapeHTML(t('sellerOrdersTitle'))}</h2>
        <table class="data-table">
          <thead>
            <tr>
              <th>${escapeHTML(t('orderIdLabel'))}</th>
              <th>${escapeHTML(t('deliverTo'))}</th>
              <th>${escapeHTML(t('total'))}</th>
              <th>${escapeHTML(t('modStatusLabel'))}</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            ${s.orders.map((o) => `
              <tr>
                <td><a href="#/order/${escapeHTML(o.id)}" style="font-weight:700;"><bdi>#${escapeHTML(o.id)}</bdi></a></td>
                <td>${escapeHTML(o.address)}</td>
                <td class="tabular">${formatPrice(o.totalUsd, { exact: true })}</td>
                <td><span class="badge ${o.status === 'delivered' ? 'badge-success' : 'badge-info'}">${escapeHTML(getOrderStatusLabel(o.status))}</span></td>
                <td>
                  ${o.status !== 'delivered' ? `<button type="button" class="btn btn-sm btn-secondary seller-step-ord" data-id="${escapeHTML(o.id)}">${escapeHTML(t('advanceOrderBtn'))}</button>` : '✓'}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      outlet.appendChild(ordBox);

      ordBox.querySelectorAll('.seller-step-ord').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const nextMap = { packing: 'shipped', shipped: 'delivered' };
          Store.set({
            orders: Store.state.orders.map((o) => o.id === id ? { ...o, status: nextMap[o.status] || 'delivered' } : o)
          });
          showToast(t('savedToast'), 'success');
          router({ preserveScroll: true });
        });
      });
    }

    function enhanceSettingsPanel(outlet) {
      const s = Store.state;
      const panel = outlet.querySelector('#settings-panel-body');
      if (!panel) return;

      if (activeSettingsSection === 'language') {
        const extra = document.createElement('div');
        extra.style.cssText = 'display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-block-top:14px;padding-block-start:14px;border-block-start:1px solid var(--border);';
        extra.innerHTML = `
          <div>
            <label class="field-label">${escapeHTML(t('dateFormatLabel'))}</label>
            <select class="select" id="set-date-fmt">
              <option value="auto" ${s.dateFormat === 'auto' ? 'selected' : ''}>Auto (${escapeHTML(formatDate(Date.now()))})</option>
              <option value="dmy" ${s.dateFormat === 'dmy' ? 'selected' : ''}>DD.MM.YYYY</option>
              <option value="mdy" ${s.dateFormat === 'mdy' ? 'selected' : ''}>MM/DD/YYYY</option>
            </select>
          </div>
          <div>
            <label class="field-label">${escapeHTML(t('unitsLabel'))}</label>
            <select class="select" id="set-units-sel">
              <option value="metric" ${s.units === 'metric' ? 'selected' : ''}>${escapeHTML(t('unitsMetric'))}</option>
              <option value="imperial" ${s.units === 'imperial' ? 'selected' : ''}>${escapeHTML(t('unitsImperial'))}</option>
            </select>
          </div>
        `;
        panel.appendChild(extra);
        extra.querySelector('#set-date-fmt')?.addEventListener('change', (e) => {
          Store.set({ dateFormat: e.target.value });
          showToast(t('savedToast'), 'success');
        });
        extra.querySelector('#set-units-sel')?.addEventListener('change', (e) => {
          Store.set({ units: e.target.value });
          showToast(t('savedToast'), 'success');
        });
      }

      if (activeSettingsSection === 'account' && s.currentUser) {
        const grads = [
          'linear-gradient(135deg, #FF6A2E, #FFD166)',
          'linear-gradient(135deg, #EC4899, #8B5CF6)',
          'linear-gradient(135deg, #10B981, #3B82F6)',
          'linear-gradient(135deg, #F59E0B, #EF4444)'
        ];
        const accExtra = document.createElement('div');
        accExtra.style.cssText = 'margin-block-start:16px;padding-block-start:16px;border-block-start:1px solid var(--border);display:flex;flex-direction:column;gap:14px;';
        accExtra.innerHTML = `
          <div>
            <label class="field-label">${escapeHTML(t('avatarPresetLabel'))}</label>
            <div style="display:flex;gap:10px;">
              ${grads.map((g) => `
                <button type="button" data-avatar-grad="${g}" style="width:38px;height:38px;border-radius:50%;background:${g};border:3px solid ${s.currentUser.avatarGrad === g ? 'var(--text)' : 'transparent'};"></button>
              `).join('')}
            </div>
          </div>
          <form id="set-pass-form" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
            <div style="flex:1;min-width:200px;">
              <label class="field-label">${escapeHTML(t('changePassLabel'))}</label>
              <input type="password" class="input" name="newpass" minlength="6" required placeholder="${escapeHTML(t('newPassPlaceholder'))}" />
            </div>
            <button type="submit" class="btn btn-secondary">${escapeHTML(t('saveChangesBtn'))}</button>
          </form>
        `;
        panel.appendChild(accExtra);

        accExtra.querySelectorAll('[data-avatar-grad]').forEach((btn) => {
          btn.addEventListener('click', () => {
            Store.set({ currentUser: { ...s.currentUser, avatarGrad: btn.getAttribute('data-avatar-grad') } });
            renderSettingsPage(outlet);
            showToast(t('savedToast'), 'success');
          });
        });
        accExtra.querySelector('#set-pass-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          e.target.reset();
          showToast(t('passUpdatedToast'), 'success');
        });
      }
    }

    function renderNotFoundPage(outlet) {
      outlet.innerHTML = `
        <div class="card-box" style="text-align:center;padding:56px 20px;max-width:540px;margin:24px auto;">
          <div style="font-size:var(--fs-44);font-weight:800;color:var(--primary);margin-block-end:8px;">404</div>
          <h1 style="font-size:var(--fs-20);margin-block-end:14px;">${escapeHTML(t('pageNotFound'))}</h1>
          <form id="notfound-search-form" style="display:flex;gap:8px;margin-block-end:18px;">
            <input type="search" class="input" name="q" placeholder="${escapeHTML(t('searchPlaceholder'))}" required />
            <button type="submit" class="btn btn-primary">${escapeHTML(t('searchBtn'))}</button>
          </form>
          <a href="#/" class="btn btn-secondary">${escapeHTML(t('home'))}</a>
        </div>
      `;
      document.getElementById('notfound-search-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = String(new FormData(e.target).get('q') || '').trim();
        location.hash = `#/catalog?q=${encodeURIComponent(q)}`;
      });
    }

    function maybeShowCookieBanner() {
      const s = Store.state;
      const cb = document.getElementById('cookie-banner');
      if (!cb || s.cookieAccepted || !s.onboarded) {
        cb?.classList.remove('visible');
        return;
      }
      cb.innerHTML = `
        <p style="font-size:var(--fs-12);margin-block-end:10px;">${escapeHTML(t('cookieText'))}</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button type="button" class="btn btn-primary btn-sm" id="accept-cookie-btn">${escapeHTML(t('acceptCookies'))}</button>
          <button type="button" class="btn btn-secondary btn-sm" id="custom-cookie-btn">${escapeHTML(t('customizeCookies'))}</button>
        </div>
      `;
      cb.classList.add('visible');

      document.getElementById('accept-cookie-btn')?.addEventListener('click', () => {
        Store.set({ cookieAccepted: true });
        cb.classList.remove('visible');
      });

      document.getElementById('custom-cookie-btn')?.addEventListener('click', () => {
        const prefs = Store.state.cookiePrefs || { essential: true, analytics: true, personalization: true };
        openModal(`
          <h3 style="font-size:var(--fs-18);margin-block-end:14px;">${escapeHTML(t('cookieModalTitle'))}</h3>
          <div style="display:flex;flex-direction:column;gap:12px;margin-block-end:18px;">
            <label style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <span style="font-size:var(--fs-14);font-weight:600;">${escapeHTML(t('cookieEssentialLabel'))}</span>
              <input type="checkbox" checked disabled />
            </label>
            <label style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <span style="font-size:var(--fs-14);font-weight:600;">${escapeHTML(t('cookieAnalyticsLabel'))}</span>
              <input type="checkbox" id="ck-analytics" ${prefs.analytics ? 'checked' : ''} />
            </label>
            <label style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <span style="font-size:var(--fs-14);font-weight:600;">${escapeHTML(t('cookiePersonalLabel'))}</span>
              <input type="checkbox" id="ck-personal" ${prefs.personalization ? 'checked' : ''} />
            </label>
          </div>
          <button type="button" class="btn btn-primary" id="save-cookie-prefs" style="width:100%;">${escapeHTML(t('saveCookiePrefsBtn'))}</button>
        `);
        document.getElementById('save-cookie-prefs')?.addEventListener('click', () => {
          const analytics = Boolean(document.getElementById('ck-analytics')?.checked);
          const personalization = Boolean(document.getElementById('ck-personal')?.checked);
          Store.set({
            cookieAccepted: true,
            cookiePrefs: { essential: true, analytics, personalization },
            ...(!personalization ? { searchHistory: [], recentlyViewed: [] } : {})
          });
          cb.classList.remove('visible');
          closeModal();
          showToast(t('savedToast'), 'success');
        });
      });
    }

    /* ==========================================================================
       GLOBAL DELEGATED LISTENERS, SCROLL HANDLERS, TIMERS & BOOTSTRAP
       ========================================================================== */
    document.addEventListener('click', (e) => {
      const actionBtn = e.target.closest('[data-action]');
      if (actionBtn) {
        const action = actionBtn.getAttribute('data-action');
        const id = actionBtn.getAttribute('data-id');
        if (action === 'add-to-cart' && id) {
          addToCart(id, 1, actionBtn);
          const spanEl = actionBtn.querySelector('span');
          if (spanEl) {
            const cItem = Store.state.cart.find((c) => c.productId === id);
            spanEl.textContent = `${t('inCart')} (${formatNum(cItem ? cItem.qty : 1)})`;
          }
          actionBtn.classList.remove('btn-primary');
          actionBtn.classList.add('btn-secondary');
        } else if (action === 'toggle-wish' && id) {
          triggerHaptic(10);
          const exists = Store.state.wishlist.includes(id);
          const next = exists ? Store.state.wishlist.filter((x) => x !== id) : [id, ...Store.state.wishlist];
          Store.set({ wishlist: next });
          actionBtn.classList.toggle('active', !exists);
          Motion.bounceEl(actionBtn);
        } else if (action === 'toggle-compare' && id) {
          triggerHaptic(10);
          const exists = Store.state.compare.includes(id);
          const next = exists ? Store.state.compare.filter((x) => x !== id) : [id, ...Store.state.compare].slice(0, 4);
          Store.set({ compare: next });
          actionBtn.classList.toggle('active', !exists);
          showToast(t(exists ? 'removedCompareToast' : 'addedCompareToast'), 'info');
        } else if (action === 'quick-view' && id) {
          openQuickViewModal(id);
        } else if (action === 'stock-alert' && id) {
          triggerHaptic(12);
          const exists = Store.state.stockAlerts.includes(id);
          const next = exists ? Store.state.stockAlerts.filter((x) => x !== id) : [...Store.state.stockAlerts, id];
          Store.set({ stockAlerts: next });
          const spanEl = actionBtn.querySelector('span');
          if (spanEl) spanEl.textContent = t(exists ? 'notifyMe' : 'subscribedStock');
          actionBtn.classList.toggle('btn-primary', !exists);
          actionBtn.classList.toggle('btn-secondary', exists);
          showToast(t(exists ? 'removedCompareToast' : 'subscribedStock'), 'success');
        }
      }

      if (!e.target.closest('.search-wrap')) {
        document.getElementById('search-dropdown')?.classList.remove('open');
      }
      if (!e.target.closest('#mega-menu') && !e.target.closest('#mega-menu-toggle')) {
        document.getElementById('mega-menu')?.classList.remove('open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
        document.getElementById('mega-menu')?.classList.remove('open');
        document.getElementById('search-dropdown')?.classList.remove('open');
        document.getElementById('catalog-sidebar')?.classList.remove('mobile-open');
      }
    });

    // Smart Sticky Header (hide on scroll down, reveal on scroll up) & Sticky PDP Bar
    let lastScrollY = window.scrollY;
    window.addEventListener('scroll', () => {
      const currentY = window.scrollY;
      const header = document.getElementById('site-header');
      if (header) {
        const megaOpen = document.getElementById('mega-menu')?.classList.contains('open');
        const searchOpen = document.getElementById('search-dropdown')?.classList.contains('open');
        if (currentY > 110 && currentY > lastScrollY + 8 && !megaOpen && !searchOpen) {
          header.classList.add('header-hidden');
        } else if (currentY < lastScrollY - 6 || currentY <= 60) {
          header.classList.remove('header-hidden');
        }
      }
      lastScrollY = currentY;

      const pdpBar = document.getElementById('sticky-pdp-bar');
      if (pdpBar) {
        pdpBar.classList.toggle('visible', currentY > 480);
      }
    }, { passive: true });

    // Offline / Online listeners
    window.addEventListener('offline', () => showToast(t('offlineNotice'), 'error'));
    window.addEventListener('online', () => showToast(t('onlineNotice'), 'success'));

    // Flash sale countdown timer (paused when tab is hidden)
    let flashSeconds = 4 * 3600 + 42 * 60 + 19;
    setInterval(() => {
      if (document.hidden) return;
      flashSeconds = flashSeconds > 0 ? flashSeconds - 1 : 14400;
      const el = document.getElementById('flash-countdown');
      if (el) {
        const h = String(Math.floor(flashSeconds / 3600)).padStart(2, '0');
        const m = String(Math.floor((flashSeconds % 3600) / 60)).padStart(2, '0');
        const s = String(flashSeconds % 60).padStart(2, '0');
        el.textContent = `${h}:${m}:${s}`;
      }
    }, 1000);

    // Initialize Store & Subscriptions
    Store.init();

    // Point-update badges without destroying header DOM or search focus
    Store.subscribe(['cart', 'wishlist', 'compare', 'currentUser'], () => {
      updateHeaderBadgesOnly();
    });

    renderHeader();
    renderFooter();
    router();
    window.addEventListener('hashchange', () => router());

    if (!Store.state.onboarded) {
      openOnboardingScreen();
    } else {
      maybeShowCookieBanner();
    }

    // Guaranteed Splash Screen dismissal
    setTimeout(() => {
      document.getElementById('splash-screen')?.classList.add('hidden');
      Motion.animateLogoRays();
    }, 320);
  </script>
</body>
