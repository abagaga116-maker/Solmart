    const Store = {
      state: null,
      subscribers: new Set(),
      saveTimer: null,
      memoryOnly: false,
      init() {
        const defaults = getDefaultState();
        try {
          const raw = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            this.state = { ...defaults, ...parsed, schemaVersion: SCHEMA_VERSION };
            // Migrate seed products if missing Arabic titles
            if (!Array.isArray(this.state.products) || this.state.products.length < 60 || !this.state.products[0]?.title?.ar) {
              this.state.products = generateSeedCatalog();
            }
            if (!Array.isArray(this.state.shops) || !this.state.shops[0]?.desc?.ar) {
              this.state.shops = INITIAL_SHOPS;
            }
          } else {
            this.state = defaults;
            this.saveImmediate();
          }
        } catch (err) {
          this.memoryOnly = true;
          this.state = defaults;
        }
        this.applyDocumentAttributes();
      },
      set(partial) {
        const changedKeys = Object.keys(partial);
        this.state = { ...this.state, ...partial };
        this.scheduleSave();
        this.applyDocumentAttributes();
        this.notify(changedKeys);
      },
      subscribe(keysOrFn, maybeFn) {
        const entry = typeof keysOrFn === 'function'
          ? { keys: null, fn: keysOrFn }
          : { keys: Array.isArray(keysOrFn) ? keysOrFn : [keysOrFn], fn: maybeFn };
        this.subscribers.add(entry);
        return () => this.subscribers.delete(entry);
      },
      notify(changedKeys) {
        this.subscribers.forEach((sub) => {
          if (!sub.keys || sub.keys.some((k) => changedKeys.includes(k))) {
            sub.fn(this.state, changedKeys);
          }
        });
      },
      scheduleSave() {
        clearTimeout(this.saveTimer);
        this.saveTimer = setTimeout(() => this.saveImmediate(), 150);
      },
      saveImmediate() {
        if (this.memoryOnly) return;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(this.state));
        } catch (e) {}
      },
      applyDocumentAttributes() {
        const s = this.state;
        const html = document.documentElement;
        html.lang = s.lang || 'en';
        html.dir = s.lang === 'ar' ? 'rtl' : 'ltr';
        const effectiveTheme = s.theme === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : (s.theme || 'light');
        html.setAttribute('data-theme', effectiveTheme);
        html.setAttribute('data-font-scale', s.fontScale || 'normal');
        html.setAttribute('data-density', s.density || 'comfortable');
        html.setAttribute('data-radius', s.radius || 'normal');
        html.setAttribute('data-motion', s.motion || 'full');
        html.setAttribute('data-contrast', s.highContrast ? 'high' : 'normal');
        html.setAttribute('data-bold-text', s.boldText ? 'true' : 'false');
        html.setAttribute('data-underline-links', s.underlineLinks ? 'true' : 'false');
        html.setAttribute('data-large-targets', s.largeTargets ? 'true' : 'false');
        html.setAttribute('data-icon-labels', s.iconLabels !== false ? 'true' : 'false');
        if (s.accentColor) {
          html.style.setProperty('--primary', s.accentColor);
        }
        const metaTheme = document.getElementById('meta-theme-color');
        if (metaTheme) {
          metaTheme.setAttribute('content', effectiveTheme === 'dark' ? '#1B1B22' : (s.accentColor || '#FF6A2E'));
        }
        const skipEl = document.getElementById('skip-link-el');
        if (skipEl) skipEl.textContent = DICT[s.lang]?.skipToContent || DICT.en.skipToContent;
        const toastCont = document.getElementById('toast-container');
        if (toastCont) toastCont.classList.toggle('pos-top', s.toastPos === 'top');
      }
    };

