      outlet.querySelectorAll('.checkout-step-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          checkoutStep = Number(tab.getAttribute('data-step'));
          renderCheckoutPage(outlet);
        });
      });

      outlet.querySelectorAll('input[name="saved_addr"]').forEach((r) => {
        r.addEventListener('change', () => {
          checkoutDraft.address = r.value;
          const inp = document.getElementById('custom-addr-input');
          if (inp) inp.value = r.value;
        });
      });

      document.getElementById('custom-addr-input')?.addEventListener('input', (e) => {
        checkoutDraft.address = e.target.value;
      });

      outlet.querySelectorAll('input[name="deliv_method"]').forEach((r) => {
        r.addEventListener('change', () => { checkoutDraft.deliveryMethod = r.value; });
      });

      outlet.querySelectorAll('input[name="pay_method"]').forEach((r) => {
        r.addEventListener('change', () => { checkoutDraft.paymentMethod = r.value; });
      });

      document.getElementById('use-points-cb')?.addEventListener('change', (e) => {
        checkoutDraft.usePoints = e.target.checked;
        renderCheckoutPage(outlet);
      });

      document.getElementById('prev-step-btn')?.addEventListener('click', () => {
        checkoutStep = Math.max(1, checkoutStep - 1);
        renderCheckoutPage(outlet);
      });

      document.getElementById('next-step-btn')?.addEventListener('click', () => {
        if (checkoutStep === 1 && !checkoutDraft.address.trim()) {
          const inp = document.getElementById('custom-addr-input');
          inp?.classList.add('error');
          Motion.shake(inp);
          inp?.focus();
          return;
        }
        checkoutStep = Math.min(4, checkoutStep + 1);
        renderCheckoutPage(outlet);
      });

      document.getElementById('place-order-btn')?.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        btn.innerHTML = `<span>${escapeHTML(t('processingPayment'))}</span>`;
        triggerHaptic(25);

        setTimeout(() => {
          const orderItems = s.cart.filter((c) => c.selected).map((c) => {
            const p = s.products.find((x) => x.id === c.productId);
            return { productId: c.productId, qty: c.qty, price: p ? p.price : 50 };
          });
          const newOrder = {
            id: 'SOL-' + Math.floor(100000 + Math.random() * 900000),
            date: Date.now(),
            status: 'packing',
            totalUsd: finalPayable,
            address: checkoutDraft.address,
            deliveryMethod: checkoutDraft.deliveryMethod,
            items: orderItems
          };
          const earnedPts = Math.round(finalPayable * 0.05);
          const updatedUser = s.currentUser
            ? {
                ...s.currentUser,
                loyaltyPoints: Math.max(0, s.currentUser.loyaltyPoints - (pointsDiscount * 20) + earnedPts)
              }
            : null;

          Store.set({
            orders: [newOrder, ...s.orders],
            cart: s.cart.filter((c) => !c.selected),
            promoCode: null,
            ...(updatedUser ? { currentUser: updatedUser } : {})
          });
          checkoutStep = 5;
          Motion.confetti();
          renderCheckoutPage(outlet);
        }, Motion.isReduced() ? 50 : 650);
      });
    }

